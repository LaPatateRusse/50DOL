# =============================================================
# TechAssist — Variables d'environnement
# Copiez ce fichier en .env.local pour le développement local
# =============================================================

# --- Base de données ---
# PostgreSQL (Vercel Postgres, Supabase, Neon, ou autre)
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/techassist"

# --- Authentification Admin ---
# Mot de passe pour accéder au dashboard /admin
ADMIN_PASSWORD="votre-mot-de-passe-securise"

# --- Sécurité des sessions ---
# Clé secrète pour signer les tokens de session (générez une chaîne aléatoire)
SESSION_SECRET="votre-cle-secrete-aleatoire-longue"

# --- Email (Resend) ---
# Créez un compte gratuit sur resend.com et récupérez votre clé API
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Adresse email expéditrice (doit être vérifiée dans Resend)
# Format : "Nom <email@votredomaine.fr>"
RESEND_FROM_EMAIL="TechAssist <contact@votredomaine.fr>"

# --- Contact public ---
# Email affiché sur le site et dans le footer
NEXT_PUBLIC_CONTACT_EMAIL="contact@votredomaine.fr"
